# ─────────────────────────────────────────────────────────────────────────────
# Dotloop Application Client credentials
# Get these from: dotloop.com → log in as the API account → My Account → Clients
# The Secret is shown exactly once. If you lose it, use "Reset Secret".
# ─────────────────────────────────────────────────────────────────────────────
DOTLOOP_CLIENT_ID=
DOTLOOP_CLIENT_SECRET=

# Evergreen refresh token. Obtain it once with: npm run get-token
# This does not expire. Treat it like a password.
DOTLOOP_REFRESH_TOKEN=

# Redirect URL registered on the Dotloop Client. Must match EXACTLY.
# The get-token helper listens on this port.
REDIRECT_PORT=5858
DOTLOOP_REDIRECT_URI=http://localhost:5858/callback

# Where downloaded contract PDFs are written (defaults to the OS temp directory)
# DOTLOOP_DOWNLOAD_DIR=/Users/you/Documents/dotloop-downloads

# ─────────────────────────────────────────────────────────────────────────────
# HOSTED SERVER — OAuth mode (what agents use from Desktop, Cowork, and mobile)
# ─────────────────────────────────────────────────────────────────────────────
# Setting PUBLIC_URL turns on OAuth mode. Each agent connects the connector,
# logs into Dotloop themselves, and sees only their own loops.
#
# Must be the public https base URL, no trailing slash.
# PUBLIC_URL=https://dotloop-mcp.up.railway.app

# IMPORTANT: add <PUBLIC_URL>/oauth/dotloop-callback to your Dotloop
# Application Client's Redirect URLs, or every agent login will be rejected.

# Where agent grants are stored. On Railway this is ephemeral unless you attach
# a volume — without one, agents reconnect after each deploy.
# STORE_PATH=/data/oauth.json

# Optional in OAuth mode: enables GET /agents to list who is connected.
# Required in single-account mode as the fixed bearer token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=

# Port (Railway sets this automatically — only needed for local testing)
PORT=3000
