# Copy this file to .env and fill in real values. Never commit .env.
#
# Meta (Facebook/Instagram) Graph API credentials.
# The token needs Page Access Token privileges for the FB page below and
# must be linked to the IG Business Account below. Generate/refresh it in
# the Graph API Explorer (https://developers.facebook.com/tools/explorer/).
META_ACCESS_TOKEN=

# Instagram Business Account ID (not the @handle)
META_IG_ID=17841404028087828

# Facebook Page ID
META_FB_PAGE_ID=227517480778696

# Graph API version
META_API_VERSION=v21.0

# Port the server listens on
PORT=3000

# Optional: override the Graph API base URL. Only useful for local testing
# against a mock server -- leave unset to hit the real Meta API.
# META_GRAPH_BASE_URL=https://graph.facebook.com

# GoHighLevel (optional) -- powers the "Upcoming Posts" section, pulled
# from the Social Planner. Leave both blank to just hide that section.
# GHL_API_KEY is a Private Integration Token: in your GHL account, go to
# Settings -> Private Integrations -> Create, and grant it read access to
# "Social Media Posting / Posts". GHL_LOCATION_ID is the location (sub-
# account) ID for this specific client, found in GHL's URL when viewing
# that location, or via the /locations/search API.
GHL_API_KEY=
GHL_LOCATION_ID=
