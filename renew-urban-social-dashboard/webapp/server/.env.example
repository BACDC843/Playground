# Copy this file to .env and fill in real values. Never commit .env.
#
# Meta (Facebook/Instagram) Graph API credentials.
# The token needs Page Access Token privileges for the FB page below and
# must be linked to the IG Business Account below. Generate/refresh it in
# the Graph API Explorer (https://developers.facebook.com/tools/explorer/).
META_ACCESS_TOKEN=

# Instagram Business Account ID (not the @handle)
META_IG_ID=17841404028087828

# Facebook Page ID
META_FB_PAGE_ID=227517480778696

# Graph API version
META_API_VERSION=v21.0

# Blotato API key (Blotato dashboard -> Settings -> API). Powers the
# "Upcoming Posts" section -- pulls scheduled-but-not-yet-published posts
# for this client's connected accounts. Leave unset and that section just
# hides itself.
BLOTATO_API_KEY=

# Instagram username (not Blotato's internal account id -- Blotato IG
# schedules don't carry Meta's IG Business Account ID, only the connected
# username) used to filter this shared Blotato workspace down to just this
# client's scheduled IG posts.
BLOTATO_IG_USERNAME=renew_urban

# Port the server listens on
PORT=3000

# Optional: override the Graph API base URL. Only useful for local testing
# against a mock server -- leave unset to hit the real Meta API.
# META_GRAPH_BASE_URL=https://graph.facebook.com

# ── Post approvals (Approvals tab) ──────────────────────────────────────────
# Passcode Renew Urban types in to review posts. Share it with them directly.
REVIEW_PASSCODE=
# Supabase project that stores approval decisions (table ru_post_decisions).
# Use the service role key -- it stays on the server and is never sent to
# the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Schedule approved posts in Blotato automatically (true/false).
AUTO_SCHEDULE=true
# Blotato account ids for Renew Urban's Instagram and the account that owns
# the Facebook page. Defaults are already correct.
# BLOTATO_IG_ACCOUNT_ID=60850
# BLOTATO_FB_ACCOUNT_ID=42817
# PUBLIC_BASE_URL=https://renewurban.chsmediagroup.com
